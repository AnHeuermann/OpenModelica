// name: initialStateSelection
// keywords: initialization, dynamic state selection
// status: correct
//
// --initialStateSelection selects the states of each state set in the
// initial system.

loadString("
model PendulumHorizontal
  parameter Real L = 1, m = 1, g = 9.81;
  Real x(start = L, fixed = true), y(start = 0);
  Real vx(start = 0), vy(start = 0.5, fixed = true);
  Real F;
equation
  der(x) = vx;
  der(y) = vy;
  m*der(vx) = -x*F;
  m*der(vy) = -y*F - m*g;
  x^2 + y^2 = L^2;
end PendulumHorizontal;
"); getErrorString();
setCommandLineOptions("--initialStateSelection"); getErrorString();
simulate(PendulumHorizontal, stopTime = 1); getErrorString();
val(vy, 0);
val(x, 1);
val(y, 1);

