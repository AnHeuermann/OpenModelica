// name: linearArrayLoop
// keywords: NewBackend array linear system simCodeScalarize
// status: correct
//
// Without sim code scalarization the linear loops with elements of the arrays
// x and z as iteration variables are linear systems, not nonlinear systems.

loadString("
model linearArrayLoop
  parameter Integer N = 6;
  Real x[N];
  Real y[N];
  Real z[2, 3];
equation
  for i in 1:N-1 loop
    2*x[i] + x[i+1] = y[i];
  end for;
  2*x[N] + x[1] = y[N];
  for i in 1:N loop
    y[i] = i*time + 1;
  end for;
  for j in 1:3 loop
    z[1, j] = j;
  end for;
  2*z[2, 1] + z[2, 2] = z[1, 1];
  2*z[2, 2] + z[2, 3] = z[1, 2] + time;
  2*z[2, 3] + z[2, 1] = z[1, 3];
end linearArrayLoop;
"); getErrorString();

setCommandLineOptions("--newBackend --simCodeScalarize=false"); getErrorString();
simulate(linearArrayLoop); getErrorString();
regexBool(readFile("linearArrayLoop.makefile"), "OMC_NUM_NONLINEAR_SYSTEMS=0 ");
val(x[1], 1.0);
val(x[6], 1.0);
val(z[2, 1], 1.0);
val(z[2, 3], 1.0);

